{
  "name": "awesome-echocardiography",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:design && npm run check:design && astro check && astro build && node scripts/check-site-design.mjs --built && node scripts/check-agent-reader.mjs",
    "preview": "astro preview",
    "check:design": "node scripts/check-site-design.mjs",
    "test:design": "node --test tests/site-design.test.mjs tests/agent-reader.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "katex": "^0.16.47",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
