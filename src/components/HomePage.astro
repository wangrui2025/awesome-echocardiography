---
import '../styles/global.css';
import SiteNav from './SiteNav.astro';
import { papers, datasets } from '../data';

interface Props {
  locale: 'zh' | 'en';
}

const { locale } = Astro.props;
const isZh = locale === 'zh';

const copy = isZh ? {
  lang: 'zh-CN',
  description: '超声心动图人工智能领域的精选论文、数据集与研究资源。',
  eyebrow: 'v0.1 · 暂时保持小而精',
  lead: '超声心动图人工智能研究资源的精选入口。',
  repo: 'GitHub 仓库 ↗',
  count: '3 篇论文 · 2 个数据集',
  research: '研究',
  papers: '论文',
  papersNote: '第一版有意只收录 3 篇超声心动图视频分割论文。',
  codePolicy: '代码状态按仓库中实际公开的可运行内容核验；只有空壳或 Coming Soon 不算“代码已公开”。',
  codePolicyLink: '查看核验标准 ↗',
  data: '数据',
  datasets: '数据集',
  datasetsNote: '不只是给下载链接：每个数据集都解释它的标注、特点、适合任务和使用注意事项。',
  paper: '论文 ↗',
  repository: '官方仓库 ↗',
  datasetCode: '代码 ↗',
  codeAvailable: '代码已公开',
  codePartial: '部分代码',
  codeAnnounced: '代码预告',
  codeNone: '暂无公开代码',
  verified: '状态核验',
  project: '项目 ↗',
  dataset: '官方数据 ↗',
  details: '了解特点 →',
  benchmark: '公共标准',
  metrics: '指标与报告规范',
  metricsNote: '统一 Dice、IoU、HD、ASD、HD95、LVEF 的定义、单位和报告方式，让不同论文的结果真正可比较。',
  metricsCta: '查看指标页 →',
  footer: '这是一个聚焦、面向社区的索引。后续将逐步扩充。',
  suggest: '推荐收录 ↗',
} : {
  lang: 'en',
  description: 'A curated collection of papers, datasets, and resources for AI in echocardiography.',
  eyebrow: 'v0.1 · deliberately small',
  lead: 'A curated starting point for artificial intelligence in echocardiography.',
  repo: 'GitHub repository ↗',
  count: '3 papers · 2 datasets',
  research: 'Research',
  papers: 'Papers',
  papersNote: 'For the first release, the list is intentionally limited to three echocardiography video-segmentation papers.',
  codePolicy: 'Code status is verified from the runnable public repository contents. Placeholder or “coming soon” repositories do not count as released code.',
  codePolicyLink: 'Review the policy ↗',
  data: 'Data',
  datasets: 'Datasets',
  datasetsNote: 'More than download links: each dataset page explains labels, strengths, suitable tasks and usage caveats.',
  paper: 'Paper ↗',
  repository: 'Official repo ↗',
  datasetCode: 'Code ↗',
  codeAvailable: 'Code available',
  codePartial: 'Partial code',
  codeAnnounced: 'Code announced',
  codeNone: 'No public code',
  verified: 'Verified',
  project: 'Project ↗',
  dataset: 'Official data ↗',
  details: 'Why this dataset →',
  benchmark: 'Open benchmark',
  metrics: 'Metrics & reporting guide',
  metricsNote: 'Normalize definitions, units and reporting for Dice, IoU, HD, ASD, HD95 and LVEF so results are genuinely comparable.',
  metricsCta: 'Open metrics guide →',
  footer: 'Built as a focused, community-oriented index. Broader coverage will be added gradually.',
  suggest: 'Suggest an addition ↗',
};
---

<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <link rel="alternate" hreflang="zh-CN" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <title>Awesome Echocardiography</title>
  </head>
  <body>
    <main>
      <SiteNav locale={locale} switchHref={isZh ? '/en/' : '/'} current="home" />

      <header class="hero">
        <div class="eyebrow">{copy.eyebrow}</div>
        <h1>Awesome Echocardiography</h1>
        <p class="lead">{copy.lead}</p>
        <div class="hero-links">
          <a class="primary" href="https://github.com/wangrui2025/awesome-echocardiography">{copy.repo}</a>
          <span>{copy.count}</span>
        </div>
      </header>

      <section>
        <div class="section-head">
          <div>
            <p class="kicker">{copy.research}</p>
            <h2>{copy.papers}</h2>
          </div>
          <p>{copy.papersNote}</p>
        </div>

        <div class="policy-note">
          <span>{copy.codePolicy}</span>
          <a href="https://github.com/wangrui2025/awesome-echocardiography/blob/main/CONTRIBUTING.md">{copy.codePolicyLink}</a>
        </div>

        <div class="paper-list">
          {papers.map((item) => (
            <article class="paper-card">
              <div class="venue">{item.venue}</div>
              <h3>{item.title}</h3>
              <p class="authors">{item.authors}</p>
              <div class="links">
                <a href={item.paper}>{copy.paper}</a>
                <a href={item.repository}>{copy.repository}</a>
                {item.project && <a href={item.project}>{copy.project}</a>}
              </div>
              <div class="code-status-row">
                <span class:list={["code-status", `code-status--${item.codeStatus}`]}>
                  {item.codeStatus === "available" ? copy.codeAvailable : item.codeStatus === "partial" ? copy.codePartial : item.codeStatus === "announced" ? copy.codeAnnounced : copy.codeNone}
                </span>
                <span class="code-status-note" title={isZh ? item.codeNoteZh : item.codeNoteEn}>
                  {isZh ? item.codeNoteZh : item.codeNoteEn}
                </span>
                <span class="code-verified">{copy.verified}: {item.codeVerifiedAt}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="section-head">
          <div>
            <p class="kicker">{copy.data}</p>
            <h2>{copy.datasets}</h2>
          </div>
          <p>{copy.datasetsNote}</p>
        </div>

        <div class="dataset-grid">
          {datasets.map((item) => (
            <article class="dataset-card">
              <div class="dataset-name">{item.name}</div>
              <h3>{item.full}</h3>
              <p>{isZh ? item.noteZh : item.noteEn}</p>
              <div class="links">
                <a class="detail-link" href={isZh ? `/datasets/${item.slug}/` : `/en/datasets/${item.slug}/`}>{copy.details}</a>
                <a href={item.dataset}>{copy.dataset}</a>
                <a href={item.paper}>{copy.paper}</a>
                {item.code && <a href={item.code}>{copy.datasetCode}</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="standard-card-section">
        <a class="standard-card" href={isZh ? '/metrics/' : '/en/metrics/'}>
          <div>
            <p class="kicker">{copy.benchmark}</p>
            <h2>{copy.metrics}</h2>
          </div>
          <p>{copy.metricsNote}</p>
          <span>{copy.metricsCta}</span>
        </a>
      </section>

      <footer>
        <p>{copy.footer}</p>
        <a href="https://github.com/wangrui2025/awesome-echocardiography/issues">{copy.suggest}</a>
      </footer>
    </main>
  </body>
</html>
