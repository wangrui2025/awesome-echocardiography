---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import katex from 'katex';
import SiteNav from './SiteNav.astro';
import SeoHead from './SeoHead.astro';
import { metricGroupsZh, metricGroupsEn } from '../metricsContent';

interface Props {
  locale: 'zh' | 'en';
}

const { locale } = Astro.props;
const isZh = locale === 'zh';
const switchHref = isZh ? '/en/metrics/' : '/metrics/';
const groups = isZh ? metricGroupsZh : metricGroupsEn;
const metrics = groups.flatMap((group) => group.metrics);
const repoBase = 'https://github.com/wangrui2025/awesome-echocardiography/blob/main/reference/metrics_v1';

const renderMath = (formula: string) =>
  katex.renderToString(formula, {
    displayMode: true,
    throwOnError: false,
    strict: false,
    trust: false,
  });

const copy = isZh ? {
  title: '指标与报告规范',
  lead: '先确定科学问题，再选择指标；先理解指标，再固定公式和代码语义。',
  intro: '我们把指标按任务拆成四组：分割、分类/诊断、连续值/心功能、临床一致性。每个指标都按同一顺序解释：它是什么、数学公式、推荐实现规范，以及为什么这样推荐。',
  map: '任务地图',
  mapLead: '不要从“论文里常见什么指标”开始；先问你的模型到底在解决什么问题。',
  quick: '全部指标',
  metric: '指标',
  measures: '它测什么',
  direction: '方向',
  unit: '单位',
  whatIsIt: '01 · 这个指标是什么？',
  formula: '02 · 数学计算公式',
  implementation: '03 · 推荐的代码实现规范',
  rationale: '04 · 为什么这样推荐？',
  openCode: '查看 Reference v1.1 代码 ↗',
  standardEyebrow: '公共标准',
  standardTitle: 'Reference Metrics v1.1',
  standardLead: 'CPU 参考实现负责定义“指标是什么意思”。GPU 或更快实现可以替代计算过程，但必须通过同一套回归测试，不能改变数学语义。',
  audit: '分割部分继续通过 MONAI 1.5.1 CPU 一致性审计；v1.1 在此基础上新增分类、连续值预测和 Bland–Altman 一致性协议。当前公开回归测试覆盖 15 个确定性案例。',
  code: '参考实现 ↗',
  tests: '回归测试 ↗',
  auditLink: 'MONAI 1.5.1 审计 ↗',
  spec: '完整 v1.1 规范 ↗',
  reporting: '最小报告规范 v1.1',
  reportingLead: '一个指标公式正确还不够；任务定义、阈值、单位、聚合和统计协议也必须可审计。',
  rules: [
    ['任务先行', '先声明 segmentation / classification / regression / agreement；不要把不同任务的指标混成一个“总分”。'],
    ['数据与划分', '写清 dataset、train/val/test split、样本量、类别 prevalence，以及排除规则。'],
    ['原子样本', '分割按 case × structure × view × phase 逐项计算；batch size、GPU 数量和 DDP 切分不得改变权重。'],
    ['阈值', 'Sensitivity / Specificity / Precision / F1 必须声明 threshold 或 threshold-selection procedure。'],
    ['单位', '边界距离有 spacing 时用 mm，否则写 px；LVEF 用 %，LVEF 误差与 agreement 用 percentage points。'],
    ['空值 / 缺失', '明确 empty mask、单类 classification set、非有限 paired values 的处理和有效 n。'],
    ['统计', 'Bland–Altman 固定 prediction − reference、sample SD（ddof=1）与 bias ± 1.96 SD；相关性不能替代 agreement。'],
    ['版本', '固定 evaluator 版本；任何偏离 Reference Metrics v1.1 的实现都必须明确命名差异。'],
  ],
  sources: '方法学来源',
  sourcesNote: '这些来源用于说明通用评价方法与统计定义；Reference Metrics v1.1 在此基础上固定可复现的代码语义。',
  back: '返回首页 ↗',
} : {
  title: 'Metrics & reporting guide',
  lead: 'Choose the metric from the scientific question, then fix the formula and code semantics.',
  intro: 'Metrics are organized into four task families: segmentation, classification/diagnosis, continuous prediction/cardiac function, and clinical agreement. Every metric follows the same sequence: what it means, its mathematical formula, the recommended implementation contract, and why that contract is recommended.',
  map: 'Task map',
  mapLead: 'Do not start from “what metric is popular in papers.” Start from the question your model is actually answering.',
  quick: 'All metrics',
  metric: 'Metric',
  measures: 'What it measures',
  direction: 'Direction',
  unit: 'Unit',
  whatIsIt: '01 · What is this metric?',
  formula: '02 · Mathematical formula',
  implementation: '03 · Recommended implementation contract',
  rationale: '04 · Why this recommendation?',
  openCode: 'Open Reference v1.1 code ↗',
  standardEyebrow: 'Public standard',
  standardTitle: 'Reference Metrics v1.1',
  standardLead: 'The CPU reference defines metric meaning. GPU or faster implementations may replace the computation only after passing the same regression suite without changing the semantics.',
  audit: 'Segmentation semantics remain covered by the MONAI 1.5.1 CPU audit. v1.1 adds classification, continuous prediction, and Bland–Altman agreement protocols. The public regression suite now covers 15 deterministic cases.',
  code: 'Reference implementation ↗',
  tests: 'Regression tests ↗',
  auditLink: 'MONAI 1.5.1 audit ↗',
  spec: 'Full v1.1 specification ↗',
  reporting: 'Minimum reporting contract v1.1',
  reportingLead: 'A correct formula is not enough; task definition, thresholds, units, aggregation, and statistical protocol must also be auditable.',
  rules: [
    ['Task first', 'Declare segmentation / classification / regression / agreement before choosing metrics; do not collapse different scientific questions into one score.'],
    ['Data & split', 'State dataset, train/val/test split, sample size, class prevalence, and exclusions.'],
    ['Atomic item', 'For segmentation compute per case × structure × view × phase; batch size, GPU count, and DDP partitioning must not change weighting.'],
    ['Threshold', 'Sensitivity / Specificity / Precision / F1 require a declared threshold or threshold-selection procedure.'],
    ['Units', 'Use mm for boundary distance when spacing is known, otherwise px; LVEF is %, while LVEF error/agreement is in percentage points.'],
    ['Missing cases', 'Declare handling of empty masks, one-class classification sets, non-finite pairs, and effective n.'],
    ['Statistics', 'Bland–Altman fixes prediction − reference, sample SD (ddof=1), and bias ± 1.96 SD; correlation does not replace agreement.'],
    ['Versioning', 'Pin the evaluator version and explicitly name any deviation from Reference Metrics v1.1.'],
  ],
  sources: 'Method references',
  sourcesNote: 'These sources document general evaluation and statistical definitions; Reference Metrics v1.1 fixes reproducible code semantics on top of them.',
  back: 'Back home ↗',
};

const groupCounts = groups.map((group) => ({
  ...group,
  count: group.metrics.length,
}));
---

<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead title={copy.title} description={copy.lead} canonicalPath={isZh ? '/metrics/' : '/en/metrics/'} zhPath="/metrics/" enPath="/en/metrics/" />
  </head>
  <body>
    <main>
      <SiteNav locale={locale} switchHref={switchHref} current="metrics" />

      <header class="subpage-hero metrics-hero">
        <p class="eyebrow">Benchmark</p>
        <h1 class="subpage-title">{copy.title}</h1>
        <p class="lead">{copy.lead}</p>
        <p class="subpage-intro">{copy.intro}</p>
      </header>

      <section class="compact-section">
        <div class="section-head">
          <div>
            <p class="kicker">{copy.map}</p>
            <h2>{isZh ? '先选任务，再选指标' : 'Choose the task before the metric'}</h2>
          </div>
          <p>{copy.mapLead}</p>
        </div>

        <div class="metric-group-grid">
          {groupCounts.map((group, index) => (
            <a class="metric-group-card" href={'#group-' + group.id}>
              <span>{String(index + 1).padStart(2, '0')} · {group.kicker}</span>
              <strong>{group.title}</strong>
              <p>{group.intro}</p>
              <small>{group.count} {isZh ? '个指标' : 'metrics'} →</small>
            </a>
          ))}
        </div>
      </section>

      <section class="compact-section metric-quick-section">
        <div class="section-head">
          <div>
            <p class="kicker">{copy.quick}</p>
            <h2>{metrics.map((metric) => metric.name).join(' · ')}</h2>
          </div>
        </div>

        <div class="metric-table" role="table" aria-label={copy.quick}>
          <div class="metric-row metric-header" role="row">
            <span role="columnheader">{copy.metric}</span>
            <span role="columnheader">{copy.measures}</span>
            <span role="columnheader">{copy.direction}</span>
            <span role="columnheader">{copy.unit}</span>
          </div>
          {metrics.map((metric) => (
            <a class="metric-row metric-row-link" role="row" href={'#' + metric.id}>
              <span role="cell">{metric.name}</span>
              <span role="cell">{metric.short}</span>
              <span role="cell">{metric.direction}</span>
              <span role="cell">{metric.unit}</span>
            </a>
          ))}
        </div>
      </section>

      <div class="metric-groups">
        {groups.map((group, groupIndex) => (
          <section class="metric-group" id={'group-' + group.id}>
            <header class="metric-group-header">
              <div class="metric-group-number">{String(groupIndex + 1).padStart(2, '0')}</div>
              <div>
                <p class="kicker">{group.kicker}</p>
                <h2>{group.title}</h2>
                <p>{group.intro}</p>
              </div>
            </header>

            <nav class="metric-jump" aria-label={group.title}>
              {group.metrics.map((metric) => <a href={'#' + metric.id}>{metric.name}</a>)}
            </nav>

            <div class="metric-guide-list">
              {group.metrics.map((metric, metricIndex) => (
                <article class="metric-guide" id={metric.id}>
                  <header class="metric-guide-header">
                    <div class="metric-guide-number">
                      {String(groupIndex + 1).padStart(2, '0')}.{String(metricIndex + 1).padStart(2, '0')}
                    </div>
                    <div>
                      <p class="kicker">{metric.short}</p>
                      <h3>{metric.name}</h3>
                    </div>
                    <div class="metric-guide-meta">
                      <span>{metric.direction}</span>
                      <span>{metric.unit}</span>
                    </div>
                  </header>

                  <div class="metric-guide-block">
                    <p class="metric-step">{copy.whatIsIt}</p>
                    <p class="metric-explanation">{metric.what}</p>
                  </div>

                  <div class="metric-guide-block formula-block">
                    <p class="metric-step">{copy.formula}</p>
                    <div class="katex-display-wrap" set:html={renderMath(metric.formula)} />
                    <p class="formula-note">{metric.formulaNote}</p>
                  </div>

                  <div class="metric-implementation">
                    <div class="metric-guide-block">
                      <p class="metric-step">{copy.implementation}</p>
                      <ol class="standard-list">
                        {metric.rules.map((rule) => <li>{rule}</li>)}
                      </ol>
                      <a class="metric-code-link" href={repoBase + '/reference_metrics.py'}>{copy.openCode}</a>
                    </div>

                    <div class="metric-guide-block rationale-block">
                      <p class="metric-step">{copy.rationale}</p>
                      <ul class="reason-list">
                        {metric.reasons.map((reason) => <li>{reason}</li>)}
                      </ul>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <section class="reference-standard-section">
        <div class="section-head">
          <div>
            <p class="kicker">{copy.standardEyebrow}</p>
            <h2>{copy.standardTitle}</h2>
          </div>
          <p>{copy.standardLead}</p>
        </div>

        <p class="source-note reference-audit">{copy.audit}</p>
        <div class="source-links">
          <a href={repoBase + '/reference_metrics.py'}>{copy.code}</a>
          <a href={repoBase + '/test_reference_metrics.py'}>{copy.tests}</a>
          <a href={repoBase + '/monai_1_5_1_cpu_audit.json'}>{copy.auditLink}</a>
          <a href={repoBase + '/README.md'}>{copy.spec}</a>
        </div>
      </section>

      <section class="reporting-section">
        <div class="section-head">
          <div>
            <p class="kicker">Open benchmark</p>
            <h2>{copy.reporting}</h2>
          </div>
          <p>{copy.reportingLead}</p>
        </div>

        <div class="reporting-list">
          {copy.rules.map(([title, description], index) => (
            <article class="reporting-row">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="source-section">
        <p class="kicker">{copy.sources}</p>
        <p class="source-note">{copy.sourcesNote}</p>
        <div class="source-links">
          <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC5654219/">Bland–Altman reference ↗</a>
          <a href="https://scikit-learn.org/stable/modules/model_evaluation.html">Classification metrics reference ↗</a>
        </div>
      </section>

      <footer>
        <p>Awesome Echocardiography · Reference Metrics v1.1</p>
        <a href={isZh ? '/' : '/en/'}>{copy.back}</a>
      </footer>
    </main>
  </body>
</html>
